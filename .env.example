# Only needed for live mode. The offline demo (make demo) needs none of this.
# Never commit a real .env; it is gitignored.

# Jev, from https://typesafe.ai. Used by `flywheel topup` and `flywheel steer --allow-spend`.
TYPESAFE_API_KEY=

# The steering analyst runs on AWS Bedrock by default (Kimi K3). Standard AWS credentials work;
# credentials from `aws login` also need `pip install 'botocore[crt]'` (included in [steer]).
AWS_DEFAULT_REGION=us-east-1
